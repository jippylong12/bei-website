# Local dev: the app calls its OWN origin (/api/*) and the Vite dev server
# proxies that to the local btc_rag backend (see vite.config.js -> server.proxy).
# No VITE_API_URL needed here.
#
# To point the dev proxy at a different backend host/port:
#   VITE_DEV_API_TARGET=http://localhost:8081 npm run dev
